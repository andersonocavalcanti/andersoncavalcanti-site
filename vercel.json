{
  "rewrites": [
    { "source": "/amigo-secreto/novo", "destination": "/amigo-secreto/app/index.html" },
    { "source": "/amigo-secreto/entrar", "destination": "/amigo-secreto/app/index.html" },
    { "source": "/amigo-secreto/cadastro", "destination": "/amigo-secreto/app/index.html" },
    { "source": "/amigo-secreto/painel", "destination": "/amigo-secreto/app/index.html" },
    { "source": "/amigo-secreto/listas", "destination": "/amigo-secreto/app/index.html" },
